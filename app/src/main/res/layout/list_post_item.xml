<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentLayout"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/border_line"
    android:layout_marginTop="10dp"
    android:layout_margin="5dp">

    <!--Image-->
        <ImageView
        android:id="@+id/iv_thumbnail"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/border_bg"
        android:backgroundTint="#ccc"
        android:scaleType="centerCrop"
        android:clipToOutline="true"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:orientation="horizontal">

        <!--Title Star-->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="8"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_post_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhà trọ Green house 1"
                android:textStyle="bold"
                android:textSize="20dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="7"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/ic_star"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="7"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/ic_star"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="7"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/ic_star"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="7"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/ic_star"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="7"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/ic_star"/>
            </LinearLayout>

        </LinearLayout>


        <!--VIP Level-->
        <TextView
            android:id="@+id/tv_post_priority"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="vip1"
            android:textSize="15dp"
            android:gravity="center"
            android:layout_gravity="center"
            android:paddingRight="5dp"
            android:background="@drawable/border_bg"
            android:backgroundTint="#ff3300"
            android:textColor="#ffffff"/>

    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:orientation="horizontal"
        android:layout_gravity="center">

        <!--Cost-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ic_vnd"
            android:text="đ"
            android:layout_gravity="center"
            android:gravity="center"
            android:textStyle="bold"
            android:layout_marginRight="1dp"/>

        <TextView
            android:id="@+id/tv_cost_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="18.000.000 VND"
            android:textColor="#b30000"
            android:textStyle="bold"
            android:textSize="15sp" />

<!--        filled dot-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•"
            android:textSize="20sp"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginRight="5dp"
            android:layout_marginLeft="5dp"/>

        <!--Area-->
        <TextView
            android:id="@+id/tv_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18m2"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#b30000"
            android:layout_gravity="center"/>

<!--        filled dot-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•"
            android:textSize="20sp"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginRight="5dp"
            android:layout_marginLeft="5dp"/>

<!--        bedroom-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:textStyle="bold"
            android:background="@drawable/ic_single_bed"
            android:layout_gravity="center"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/tv_bedroom_number_value"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="2"
            android:layout_gravity="center"
            android:textSize="15sp"/>

<!--        filled dot-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•"
            android:textSize="20sp"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginRight="5dp"
            android:layout_marginLeft="5dp"/>

<!--        bathroom-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:textStyle="bold"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_gravity="center"
            android:background="@drawable/ic_bathtub"
            />

        <TextView
            android:id="@+id/tv_bath_num_value"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="2"
            android:gravity="center"
            android:layout_gravity="center"
            android:textSize="15sp"/>

    </LinearLayout>

    <!--Address-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="15dp"
            android:background="@drawable/ic_location"/>

        <!--Address Value-->
        <TextView
            android:id="@+id/tv_address_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xã Bình Yên, Huyện Thạch Thất, Thành phố Hà Nội"
            android:textSize="15dp"
            android:layout_gravity="center"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#ccc"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:orientation="horizontal">
        <!--Avatar-->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivOwnerAvatar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="avatar"
            android:scaleType="centerCrop"
            android:layout_gravity="center"
            android:src="@drawable/icon_avatar"
            android:layout_marginRight="5dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.LargeComponent" />

        <!--Post owner-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_post_owner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hoang Nguyen"
                android:textStyle="bold"
                android:textSize="15dp"/>

            <TextView
                android:id="@+id/tv_createdAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2025-03-05"
                android:textSize="15dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>