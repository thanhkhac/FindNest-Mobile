<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="20dp"
    android:layout_marginRight="20dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/border_dialog_payment">

    <!-- Thanh tiêu đề với nút đóng -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Tiêu đề "Nạp tiền" -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nạp tiền"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:padding="16dp"/>

        <!-- Nút đóng (X) -->
        <ImageButton
            android:background="#FFFFFF"
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/baseline_close_24"
            android:layout_gravity="end"
            android:padding="8dp"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Số dư hiện tại -->
        <TextView
            android:id="@+id/txtBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D32F2F"
            android:gravity="center"
            android:text="Số dư hiện tại\n0 VNĐ"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:padding="8dp" />

        <!-- Chú thích số tiền nạp -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Số tiền nạp (tối đa 100,000,000 VNĐ)"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginTop="16dp" />

        <!-- Ô nhập số tiền -->
        <EditText
            android:id="@+id/edtMoney"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@android:drawable/editbox_background"
            android:hint="Nhập số tiền"
            android:inputType="number"
            android:padding="10dp"
            android:layout_marginTop="8dp"/>

        <!-- Ghi chú phí hệ thống -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="* Do chi phí hệ thống, số tiền nạp tối thiểu là 20,000 VNĐ."
            android:textSize="12sp"
            android:textColor="#777777"
            android:layout_marginTop="4dp" />

        <!-- Nút tạo mã QR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateQR"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Tạo mã QR"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#448AFF"
            android:layout_marginTop="16dp"/>
        <LinearLayout
            android:id="@+id/layoutQR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center">
            <ImageView
                android:id="@+id/imageQR"
                android:layout_marginTop="10dp"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:src="@drawable/close_24px"
                android:layout_gravity="center"/>

            <!-- Chú thích quét mã QR -->
            <TextView
                android:id="@+id/txtConfirmQR"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Quét mã QR để nạp tiền: 0 VNĐ"
                android:gravity="center"/>

            <!-- Nút hoàn tất nạp tiền -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmQR"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Hoàn tất nạp tiền"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#198754"
                android:layout_marginTop="16dp"/>
        </LinearLayout>
        <!-- Ảnh mã QR -->

    </LinearLayout>

</LinearLayout>
