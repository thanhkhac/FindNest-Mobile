<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.ProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#fff"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_to_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#FFF"
            android:gravity="center"
            android:paddingStart="-10dp"
            android:text="Thông tin liên hệ"
            android:textColor="#DC3545"
            android:textSize="27sp"
            android:textStyle="bold"
            app:icon="@drawable/icon_chevron_left"
            app:iconGravity="start"
            app:iconPadding="0dp"
            app:iconSize="50dp"
            app:iconTint="#DC3545" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAvatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="avatar"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_avatar"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.LargeComponent" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:hint="Họ và tên"
                android:textColorHint="#AAA"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxStrokeColor="#DC3545"
                app:endIconMode="clear_text"
                app:endIconTint="#DC3545"
                app:hintTextColor="#DC3545">  <!-- Adds a clear (X) button -->

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtFullName"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:padding="8dp"
                    android:textColor="#000"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:hint="Số điện thoại"
                android:textColorHint="#AAA"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxStrokeColor="#DC3545"
                app:endIconMode="clear_text"
                app:endIconTint="#DC3545"
                app:hintTextColor="#DC3545">  <!-- Adds a clear (X) button -->

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtContactPhoneNumber"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:padding="8dp"
                    android:textColor="#000"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:hint="Số Zalo (nếu có)"
                android:textColorHint="#AAA"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxStrokeColor="#DC3545"
                app:endIconMode="clear_text"
                app:endIconTint="#DC3545"
                app:hintTextColor="#DC3545">  <!-- Adds a clear (X) button -->

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtZalo"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:padding="8dp"
                    android:textColor="#000"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!--            <com.google.android.material.textfield.TextInputLayout-->
            <!--                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"-->
            <!--                android:layout_width="match_parent"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:layout_marginBottom="20dp"-->
            <!--                android:hint="Email"-->
            <!--                android:textColorHint="#AAA"-->
            <!--                app:boxBackgroundMode="outline"-->
            <!--                app:boxCornerRadiusBottomEnd="8dp"-->
            <!--                app:boxCornerRadiusBottomStart="8dp"-->
            <!--                app:boxCornerRadiusTopEnd="8dp"-->
            <!--                app:boxCornerRadiusTopStart="8dp"-->
            <!--                app:boxStrokeColor="#DC3545"-->
            <!--                app:endIconMode="clear_text"-->
            <!--                app:endIconTint="#DC3545"-->
            <!--                app:hintTextColor="#DC3545">  &lt;!&ndash; Adds a clear (X) button &ndash;&gt;-->

            <!--                <com.google.android.material.textfield.TextInputEditText-->
            <!--                    android:id="@+id/edtEmail"-->
            <!--                    android:layout_width="match_parent"-->
            <!--                    android:layout_height="50dp"-->
            <!--                    android:focusable="false"-->
            <!--                    android:padding="8dp"-->
            <!--                    android:textColor="#000"-->
            <!--                    android:textSize="16sp" />-->
            <!--            </com.google.android.material.textfield.TextInputLayout>-->

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveChange"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Lưu thay đổi"
            android:textColor="#DC3545"
            app:strokeColor="#DC3545" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>