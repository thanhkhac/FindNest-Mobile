<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.CreatePostFragment">

    <!-- Nội dung chính trong NestedScrollView -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Nhập tiêu đề -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập tiêu đề bài đăng"
                app:counterEnabled="true"
                app:counterMaxLength="500">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:text="Cho thuê phòng trọ"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 2. Chọn khu vực -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khu vực"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <!-- Thành phố -->
            <Spinner
                android:id="@+id/spinner_province"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Quận huyện -->
            <Spinner
                android:id="@+id/spinner_district"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Xã phường -->
            <Spinner
                android:id="@+id/spinner_ward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Bản đồ OSM -->
            <org.osmdroid.views.MapView
                android:id="@+id/map_view"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="16dp" />

            <!-- 3. Nhập giá -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập giá (VNĐ)"
                android:layout_marginTop="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Switch Giá thỏa thuận -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_negotiable_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Giá thỏa thuận"
                android:layout_marginTop="8dp" />

            <!-- 4. Nhập diện tích -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập diện tích (m²)"
                android:layout_marginTop="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_area"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 5. Nhập số phòng ngủ -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_bedroom_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập số phòng ngủ"
                android:layout_marginTop="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_bedroom_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 6. Nhập số phòng tắm -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_bathroom_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập số phòng tắm"
                android:layout_marginTop="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_bathroom_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Ô nhập mô tả -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập mô tả"
                android:layout_marginTop="16dp"
                app:counterEnabled="true"
                app:counterMaxLength="1000">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:maxLines="10" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Ô nhập địa chỉ cụ thể -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_specific_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập địa chỉ cụ thể (ví dụ: Thôn 1)"
                android:layout_marginTop="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_specific_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Switch AI tự động điền -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_ai_auto_fill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI tự động điền"
                android:layout_marginTop="8dp" />

            <!-- 7. Tải ảnh bìa lên -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ảnh bìa"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_upload_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chọn ảnh bìa"
                android:layout_marginTop="8dp"
                app:cornerRadius="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <ImageView
                android:id="@+id/img_thumbnail_preview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:layout_marginTop="8dp" />

            <!-- 8. Tải các ảnh lên -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Danh sách ảnh"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_upload_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chọn ảnh"
                android:layout_marginTop="8dp"
                app:cornerRadius="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <!-- Hiển thị danh sách ảnh đã chọn -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                tools:listitem="@layout/item_image_preview" />

            <!-- Nút gửi bài đăng -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đăng bài"
                android:layout_marginTop="16dp"
                app:cornerRadius="8dp"
                style="@style/Widget.MaterialComponents.Button" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Overlay mờ và ProgressBar -->
    <FrameLayout
        android:id="@+id/loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Overlay mờ -->
        <View
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000" />

        <!-- ProgressBar -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

</FrameLayout>